# ==============================================================================
# visionOS Spatial Operating System - Environment Variables
# ==============================================================================
# Copy this file to `.env.local` for local development. Test deployments are
# BYOK-only: provider keys entered by testers are sent to the AI API per request.
# Server-funded keys are disabled by default and never used in production.
#
# Users enter their own Gemini or OpenRouter key in onboarding/settings. The
# browser stores that key locally and sends it to this app's API for AI requests.
# ==============================================================================

# Optional local-development server key. Ignored unless
# ALLOW_SERVER_AI_KEYS=true and NODE_ENV is not production.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini Model
# Options: gemini-3.8-flash (Recommended default), gemini-3.5-flash-lite, gemini-4-argon, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional local-development server key, subject to the opt-in above.
# OpenAI provider access uses an OpenAI API key; ChatGPT subscription sign-in is not supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional local-development server key, subject to the opt-in above.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Optional local-development failover keys (up to 5 keys); not used in production.
GEMINI_API_KEYS=
OPENAI_API_KEYS=
OPENROUTER_API_KEYS=

# Explicit non-production opt-in for local server-funded development.
# Never enable this on a deployment serving external testers.
ALLOW_SERVER_AI_KEYS=false
