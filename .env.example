# ==============================================================================
# visionOS Spatial Operating System - Environment Variables
# ==============================================================================
# NOTE: Server-only configuration. Copy this file to `.env.local` for local development.
# For Vercel deployments, add these variables in your Vercel Project Settings.
#
# Client-Side Alternative: Users can also input their Gemini API key directly into
# the client-side Onboarding Modal or Settings popover. Keys provided in the UI
# are stored ONLY in the browser's local storage and are never exposed publicly.
# ==============================================================================

# Google AI Studio API Key (Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini Model
# Options: gemini-3.8-flash (Recommended default), gemini-3.5-flash-lite, gemini-4-argon, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional: OpenRouter API Configuration
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Optional: Comma-separated failover keys for high-volume deployments (up to 5 keys)
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
